---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, ABOUT, SOCIALS } from '../config';

const machines = await getCollection('machines', ({ data }) => !data.draft);
const posts = await getCollection('posts', ({ data }) => !data.draft && !data.externalLink);

const social = (label: string) => SOCIALS.find((s) => s.label.toLowerCase() === label.toLowerCase());
const gh = social('GitHub');
const htb = social('HackTheBox');
const li = social('LinkedIn');
---

<BaseLayout bare>
  <div class="page">
    <section class="intro">
      <img class="avatar" src={SITE.avatar} alt={SITE.author} width="92" height="92" />
      <h1 class="name">{SITE.title}</h1>
      {gh && <p class="handle">{gh.handle} · aspiring red teamer</p>}
      <p class="bio">{ABOUT}</p>
    </section>

    <section class="group">
      <h2 class="glabel">Writeups</h2>
      <a class="row" href="/machines">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><circle cx="7" cy="7.5" r="1" fill="currentColor" stroke="none"/><circle cx="7" cy="16.5" r="1" fill="currentColor" stroke="none"/></svg>
        <span class="lbl">Machines</span><span class="meta">{machines.length}</span>
      </a>
      <a class="row" href="/posts">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/></svg>
        <span class="lbl">Research</span><span class="meta">{posts.length}</span>
      </a>
    </section>

    <section class="group">
      <h2 class="glabel">Elsewhere</h2>
      {gh && (
        <a class="row" href={gh.href} rel="me noopener" target="_blank">
          <img class="brand" src="/logos/github.svg" alt="" width="20" height="20" />
          <span class="lbl">GitHub</span><span class="meta">{gh.handle}</span>
        </a>
      )}
      {htb && (
        <a class="row" href={htb.href} rel="me noopener" target="_blank">
          <img class="brand" src="/logos/hackthebox.svg" alt="" width="20" height="20" />
          <span class="lbl">HackTheBox</span><span class="meta">{htb.handle}</span>
        </a>
      )}
      {li && (
        <a class="row" href={li.href} rel="me noopener" target="_blank">
          <img class="brand" src="/logos/linkedin.svg" alt="" width="20" height="20" />
          <span class="lbl">LinkedIn</span><span class="meta">{li.handle}</span>
        </a>
      )}
    </section>

    <p class="foot">built with <a href="https://astro.build">astro</a></p>
  </div>

  <style>
    .page {
      max-width: 460px; margin: 0 auto;
      min-height: 100vh; display: flex; flex-direction: column; justify-content: center;
      gap: 1.8rem; padding: 3rem 1.5rem;
    }
    .intro { text-align: center; }
    .avatar { width: 92px; height: 92px; border-radius: 50%; object-fit: cover;
              border: 1px solid var(--border); box-shadow: 0 8px 24px -12px rgba(0,0,0,.8); }
    .name { margin: 1rem 0 0; font-size: 1.8rem; font-weight: 700; letter-spacing: -.02em; color: var(--fg-strong); }
    .handle { margin: .3rem 0 0; color: var(--fg-muted); font-size: .9rem; font-family: var(--font-mono); }
    .bio { margin: 1rem 0 0; color: var(--fg); font-size: .98rem; line-height: 1.7; }

    .group { display: flex; flex-direction: column; gap: .5rem; }
    .glabel { margin: 0 0 .1rem; font-size: .72rem; font-weight: 600; letter-spacing: .13em;
              text-transform: uppercase; color: var(--fg-muted); }

    .row {
      display: flex; align-items: center; gap: .8rem;
      padding: .72rem .9rem; border: 1px solid var(--border); border-radius: 10px;
      background: var(--bg-soft); color: var(--fg); text-decoration: none; font-size: .95rem;
      transition: border-color .15s ease, background .15s ease;
    }
    .row:hover { background: var(--bg-hover); border-color: color-mix(in oklab, var(--accent) 40%, var(--border)); text-decoration: none; }
    .ic { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
    .brand { width: 20px; height: 20px; flex-shrink: 0; }
    .lbl { flex: 1; font-weight: 500; }
    .meta { color: var(--fg-muted); font-size: .85rem; font-family: var(--font-mono); }

    .foot { text-align: center; margin: .4rem 0 0; color: var(--fg-muted); font-size: .8rem; font-family: var(--font-mono); }

    @media (max-width: 420px) { .name { font-size: 1.6rem; } }
  </style>
</BaseLayout>
